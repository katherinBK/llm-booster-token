{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/auth/:path*" }
  ]
}
{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/backend"
    },
    {
      "source": "/api/payment/(.*)",
      "destination": "/api/backend"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}