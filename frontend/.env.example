# Frontend environment variables
# Copy this file to .env.local and fill in the values (never commit .env.local to git)

# Your Supabase project URL (e.g. https://wyywukatjjksaetvoekg.supabase.co)
VITE_SUPABASE_URL=https://wyywukatjjksaetvoekg.supabase.co

# Your Supabase anon/public key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API URL — in local dev this is handled by the Vite proxy,
# so you don't need it locally. Only needed if you bypass the Vite proxy.
# VITE_API_URL=http://localhost:3001
